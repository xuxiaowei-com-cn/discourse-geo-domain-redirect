{
  "private": true,
  "devDependencies": {
    "@discourse/lint-configs": "3.2.0",
    "@glint/ember-tsc": "1.8.11",
    "discourse": "npm:@discourse/types@2026.10.0-a5125163",
    "eslint": "10.6.0",
    "prettier": "3.8.1",
    "stylelint": "17.5.0"
  },
  "scripts": {
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:prettier && pnpm lint:types",
    "lint:js": "eslint {assets,admin/assets,test}/javascripts --no-error-on-unmatched-pattern",
    "lint:js:fix": "eslint {assets,admin/assets,test}/javascripts --fix --no-error-on-unmatched-pattern",
    "lint:css": "stylelint 'assets/stylesheets/**/*.scss' --allow-empty-input",
    "lint:css:fix": "stylelint 'assets/stylesheets/**/*.scss' --fix --allow-empty-input",
    "lint:prettier": "prettier 'assets/stylesheets/**/*.scss' '{assets,admin/assets,test}/javascripts/**/*.{js,gjs,ts,gts,mts,cts}' --check --no-error-on-unmatched-pattern",
    "lint:prettier:fix": "prettier 'assets/stylesheets/**/*.scss' '{assets,admin/assets,test}/javascripts/**/*.{js,gjs,ts,gts,mts,cts}' -w --no-error-on-unmatched-pattern",
    "lint:types": "ember-tsc -b"
  },
  "engines": {
    "node": ">= 22",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.28.0"
}
